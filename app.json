{
  "expo": {
    "name": "shamims",
    "slug": "shamims",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Pictures/icon.png",
    "scheme": "shamims",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/Pictures/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Pictures/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/Pictures/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
    
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}